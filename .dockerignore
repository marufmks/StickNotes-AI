# node_modules: host deps are macOS-arm64; the container installs its own
# linux-arm64 copy. Copying these over would break native modules.
node_modules

# Build output — always produced fresh inside the image
.next
out
build

# Secrets: never let an .env leak into an image layer
.env
.env.local
.env.*.local

# Git history & Vercel artifacts
.git
.gitignore
.vercel

# Not needed inside the image
Dockerfile
compose.yaml
docker-compose.yml
README.md
AGENTS.md

# Docs / OS noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
coverage
*.tsbuildinfo
